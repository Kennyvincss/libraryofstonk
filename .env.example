# ─────────────────────────────────────────────────────────────
# STONKFUN ARCHIVE — data source configuration
# ─────────────────────────────────────────────────────────────
# "demo"  → deterministic simulated dataset (clearly labelled in the UI)
# "api"   → a StonkFun indexer that implements docs/DATA_ARCHITECTURE.md
VITE_DATA_SOURCE=demo

# Base URL of the archive indexer REST API (required when VITE_DATA_SOURCE=api)
VITE_ARCHIVE_API_URL=https://archive-indexer.example.com/v1

# Optional: Server-Sent Events stream for live activity.
# If unset, the HTTP source polls  GET {API_URL}/activity?since=<ts>
VITE_ARCHIVE_LIVE_URL=

# Optional: polling interval for live activity (ms)
VITE_ARCHIVE_LIVE_POLL_MS=8000

# Optional: first day of the archive (ISO date). Defaults to 2026-01-01.
VITE_ARCHIVE_START=2026-01-01

# Optional: Solana explorer used for outbound links (mint/pool addresses)
VITE_EXPLORER_URL=https://solscan.io

# Optional: StonkFun app URL for "trade on StonkFun" links
VITE_STONKFUN_APP_URL=https://stonk.fun

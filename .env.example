# ─────────────────────────────────────────────────────────────
# STONKFUN ARCHIVE — data source configuration
# ─────────────────────────────────────────────────────────────
# "live"  → real on-chain data (default): the dataset published by the
#            indexer (indexer/, run hourly by .github/workflows/indexer.yml)
#            plus live GeckoTerminal calls for charts, trades and the feed
# "demo"  → deterministic simulated dataset (clearly labelled in the UI)
# "api"   → a custom indexer that implements docs/DATA_ARCHITECTURE.md
# Visitors can also switch with ?source=demo / ?source=live
VITE_DATA_SOURCE=live

# Where the indexer's dataset lives (default: this repo's `data` branch)
VITE_ARCHIVE_DATA_URL=https://raw.githubusercontent.com/Kennyvincss/libraryofstonk/data/v1

# GeckoTerminal API base (public, no key; ~30 requests/min per visitor)
VITE_GECKO_API=https://api.geckoterminal.com/api/v2

# Base URL of the archive indexer REST API (required when VITE_DATA_SOURCE=api)
VITE_ARCHIVE_API_URL=https://archive-indexer.example.com/v1

# Optional: Server-Sent Events stream for live activity.
# If unset, the HTTP source polls  GET {API_URL}/activity?since=<ts>
VITE_ARCHIVE_LIVE_URL=

# Optional: polling interval for live activity (ms)
VITE_ARCHIVE_LIVE_POLL_MS=8000

# Demo only: first day of the simulated archive (StonkFun launched 2026-08-03)
VITE_ARCHIVE_START=2026-08-03

# Optional: Solana explorer used for outbound links (mint/pool addresses)
VITE_EXPLORER_URL=https://solscan.io

# Optional: StonkFun app URL for "trade on StonkFun" links
VITE_STONKFUN_APP_URL=https://stonk.fun
